{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "ui_kits/_shared/**",
              "ui_kits/mobile-app/**",
              "ui_kits/web-app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Ruberoid|Sora|Inter))/i]",
        "message": "Font not provided by the design system. Available: Ruberoid, Sora, Inter."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {},
    "tokens": [
      "--fq-amber",
      "--fq-body",
      "--fq-body-sm",
      "--fq-border",
      "--fq-border-2",
      "--fq-butter",
      "--fq-caption",
      "--fq-cream",
      "--fq-display",
      "--fq-error",
      "--fq-fill",
      "--fq-font",
      "--fq-font-ui",
      "--fq-green",
      "--fq-green-700",
      "--fq-h1",
      "--fq-h1-xl",
      "--fq-h2",
      "--fq-h3",
      "--fq-h4",
      "--fq-ink",
      "--fq-micro",
      "--fq-mint",
      "--fq-mist",
      "--fq-olive",
      "--fq-orange",
      "--fq-r-lg",
      "--fq-r-md",
      "--fq-r-pill",
      "--fq-r-sm",
      "--fq-shadow-card",
      "--fq-shadow-sm",
      "--fq-success",
      "--fq-success-2",
      "--fq-text",
      "--fq-text-faint",
      "--fq-text-muted",
      "--fq-text-soft",
      "--fq-text-strong",
      "--fq-w-bold",
      "--fq-w-extra",
      "--fq-w-light",
      "--fq-w-medium",
      "--fq-w-regular",
      "--fq-w-semibold",
      "--fq-white"
    ],
    "tokenKinds": {
